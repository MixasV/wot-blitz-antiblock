{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoT Blitz Connector",
  "version": "1.0.0",
  "identifier": "com.wotblitz.connector",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "WoT Blitz Connector",
        "width": 520,
        "height": 680,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "minimumWebview2Version": "120.0.0.0"
    },
    "resources": {}
  }
}